generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum CardType {
  TEXT
  IMAGE
  LINK_BUTTON
  CONTACT
  MAP
  SOCIAL
  VIDEO_EMBED
  FILE_DOWNLOAD
  DIVIDER
  GALLERY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  pages        Page[]
  uploadedImages UploadedImage[]
}

model Page {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title       String
  slug        String    @unique
  description String?
  isPublished Boolean   @default(false)
  theme       Json
  coverImage  String?
  logo        String?
  expiresAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cards       Card[]
  scanLogs    ScanLog[]
  slugHistory PageSlugHistory[]
  uploads     UploadedImage[]

  @@index([ownerId])
  @@index([expiresAt, id])
}

model PageSlugHistory {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([pageId])
}

// Track pending uploads and ownership; references themselves live in Page/Card JSON.
model UploadedImage {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  sourcePageId String?
  sourcePage   Page?    @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  deletingAt   DateTime? @db.Timestamptz(3)

  @@index([ownerId, createdAt])
  @@index([sourcePageId])
  @@index([deletingAt])
}

model Card {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      CardType
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  content   Json
  style     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

model ScanLog {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  scannedAt  DateTime @default(now()) @db.Timestamptz(3)
  userAgent  String?
  deviceType String?
  referrer   String?
  ipHash     String?

  @@index([pageId, scannedAt])
  @@index([pageId, ipHash, scannedAt])
}
