DATABASE_URL="postgresql://barcode:barcode@localhost:5432/barcode?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Isi dengan hasil: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Opsional: domain publik khusus untuk QR, ditetapkan saat build.
# Jika masih localhost, QR mengikuti domain yang dibuka di browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Rahasia acak untuk HMAC IP; jangan gunakan NEXTAUTH_SECRET atau commit nilainya.
IP_HASH_SECRET=""
# Retensi ScanLog dalam hari; default 365.
SCAN_RETENTION_DAYS="365"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@example.com"
# Wajib diisi, minimal 12 karakter dan maksimal 72 byte.
SEED_ADMIN_PASSWORD=""

# Penyimpanan unggahan: saat ini hanya provider local yang diimplementasikan.
STORAGE_PROVIDER="local"

# Opsional: origin publik untuk canonical/OG. Default mengikuti NEXTAUTH_URL.
# SITE_URL="https://contoh.com"
